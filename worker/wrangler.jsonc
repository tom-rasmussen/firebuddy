{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firebuddy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // UI files in public/ are served directly; /api/* runs the Worker first.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  // AC-15: per-IP rate limit on /api/*.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}

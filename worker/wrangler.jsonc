{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firebuddy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // UI files in public/ are served directly; /api/* runs the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // AC-15: per-IP rate limit on /api/*. 120/min: one page load is ~8 calls, and testers may share Wi-Fi.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
